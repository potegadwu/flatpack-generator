fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="35D32B25" w14:textId="77777777" w:rsidR="00667E94" w:rsidRDefault="00667E94"/><w:p w14:paraId="400BCB5C" w14:textId="2D6A4668" w:rsidR="00667E94" w:rsidRDefault="00667E94" w:rsidP="00667E94"><w:pPr><w:rPr><w:noProof/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:t>Brief dla agencji kreatywnej i strategicznej, na wypracowanie strategii marki na poziomie komunikacji w SoMe</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/></w:r></w:p><w:p w14:paraId="5B25D55D" w14:textId="48BFD145" w:rsidR="00667E94" w:rsidRDefault="004718E9" w:rsidP="00667E94"><w:pPr><w:rPr><w:noProof/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:t>Marka która budujemy nazywa się: Flat Pack Man</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/><w:t>Belfast i Londyn, UK</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:t xml:space="preserve">Trzeba wypracować logo, manual marki i szablony i fonty a także kolory i tresci grafik -  tonality marki na podstawie 5 przykladowych graficznych postów obowiązujących na IG, FB i w komunikacji online i offlie. </w:t></w:r></w:p><w:p w14:paraId="493235AD" w14:textId="5005C148" w:rsidR="00B76441" w:rsidRDefault="00667E94" w:rsidP="00667E94"><w:pPr><w:rPr><w:noProof/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:t>Posty szablony, mają być</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:t xml:space="preserve"> w kilku kategoriach:</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/><w:t>1. Z realizacji u Klienta</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/><w:t xml:space="preserve">2. Wizerunkowe budujące informację czym się zajmujemy, jaki zakres tego co robimy, zabawne ciekawe, moze oparte o ciekawostki syzbkośc dzialania, jakość dokladność... Czy wiesz, że nasz składacz w ciągu 365 dni składa milion szaf </w:t></w:r><w:r><w:rPr><mc:AlternateContent><mc:Choice Requires="w16se"/><mc:Fallback><w:rFonts w:ascii="Segoe UI Emoji" w:eastAsia="Segoe UI Emoji" w:hAnsi="Segoe UI Emoji" w:cs="Segoe UI Emoji"/></mc:Fallback></mc:AlternateContent><w:noProof/></w:rPr><mc:AlternateContent><mc:Choice Requires="w16se"><w16se:symEx w16se:font="Segoe UI Emoji" w16se:char="1F609"/></mc:Choice><mc:Fallback><w:t>😉</w:t></mc:Fallback></mc:AlternateContent></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:t xml:space="preserve"> lub inne takie ktore pokazują markę, dynamikę, doswiadczenie </w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/><w:t xml:space="preserve">3. RTM ktore powinny byc oparte o to co dzieje się w Belfascie i Londynie w danym momencie -bo tam jest biznes ktory prowadze. </w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/><w:t>4. Opinie</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:br/><w:t>Jesli widzisz potrzebe jeszcze jakiejs kategorii to zaproponuj</w:t></w:r><w:r><w:rPr><w:noProof/></w:rPr><w:t xml:space="preserve">, na ten moment wystarczy, myślę. </w:t></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/><w:t>Chcę też projekt wizytówki</w:t></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/><w:t xml:space="preserve">Chcę też postać, ktorą mozna postawić na zdjecia w trakcie montażu u Klienta. </w:t></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/><w:t xml:space="preserve">Jeff jest czarnoskory i ta postać w marce ktora Ci pokazuje to on. </w:t></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/><w:t>Wrzucam Ci kilka zdjęć Michała, na ktorych chcę oprzeć naszą postać.</w:t></w:r><w:r w:rsidR="00E8048E"><w:rPr><w:noProof/></w:rPr><w:br/><w:t>celowo daje i zdjecia twarzy i calej postaci byś projektując karykaturując mógł odnieść się do rpawdziwej postaci, wlasciciela firmy.</w:t></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:br/></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:br/></w:r><w:r w:rsidR="00340770"><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="0BE556A3" wp14:editId="4A2B53C5"><wp:extent cx="4070152" cy="5354637"/><wp:effectExtent l="0" t="0" r="6985" b="0"/><wp:docPr id="2037029119" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="2037029119" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId4"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4072899" cy="5358251"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="36AE1162" w14:textId="795DC563" w:rsidR="00B76441" w:rsidRDefault="00B76441" w:rsidP="00667E94"><w:pPr><w:rPr><w:noProof/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="18708